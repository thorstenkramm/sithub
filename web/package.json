{
  "name": "sithub-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:auth:unauth": "cypress run --spec cypress/e2e/auth.cy.ts",
    "test:e2e:auth:test": "CYPRESS_testAuthEnabled=true cypress run --spec cypress/e2e/auth.cy.ts",
    "lint": "eslint . --max-warnings 0",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.1.0",
    "vuetify": "^3.13.6"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.21.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "cypress@15.21.1": true,
    "fsevents": false
  }
}
